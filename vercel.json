{
  "redirects": [
    {
      "destination": "/color-sphere/",
      "permanent": true,
      "source": "/color-sphere"
    },
    {
      "destination": "/unique-words/",
      "permanent": true,
      "source": "/unique-words"
    }
  ],
  "rewrites": [
    {
      "destination": "https://unique-words.vercel.app/unique-words/",
      "source": "/unique-words/"
    },
    {
      "destination": "https://unique-words.vercel.app/unique-words/:match*",
      "source": "/unique-words/:match*"
    },
    {
      "destination": "https://color-sphere.vercel.app/:match*",
      "source": "/color-sphere/:match*"
    },
    {
      "destination": "https://color-sphere.vercel.app/_next/static/:match*",
      "source": "/_next/static/:match*"
    },
    {
      "destination": "https://color-sphere.vercel.app/_next/image",
      "source": "/_next/image"
    },
    {
      "destination": "https://color-sphere.vercel.app/icon.png",
      "source": "/icon.png"
    }
  ]
}
